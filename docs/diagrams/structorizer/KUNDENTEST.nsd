<?xml version="1.0" encoding="UTF-8"?>
<root xmlns:nsd="https://structorizer.fisch.lu" version="3.32-35" preRepeat="until " postFor="to" preReturn="return" postForIn="in" preWhile="while " output="OUTPUT" input="INPUT" preFor="for" preExit="exit" preLeave="leave" ignoreCase="true" preThrow="throw" preForIn="foreach" stepFor="by" namespace="" author="Admin" created="2026-10-21" changedby="Admin" changed="2026-10-21" origin="Structorizer 3.32-35" text="&#34;KUNDENTEST&#34;" comment="&#34;&#34;" color="ffffff" type="program" style="nice">
	<children>
		<instruction text="&#34;auswahl &#60;- -1&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
		<while text="&#34;auswahl != 0&#34;" comment="&#34;&#34;" color="ffffff" disabled="0">
			<qWhile>
				<instruction text="&#34;INPUT &#34;&#34;KUNDENVERWALTUNG\n\n1 - Kunden anzeigen\n0 - Beenden\n\nAuswahl:&#34;&#34;, auswahl&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
				<case text="&#34;(auswahl)&#34;,&#34;1&#34;,&#34;0&#34;,&#34;sonst&#34;" comment="&#34;&#34;" color="ffffff" branch_colors=",," disabled="0">
					<qCase>
						<instruction text="&#34;OUTPUT &#34;&#34;Kunden anzeigen wurde gewählt.&#34;&#34;&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
					</qCase>
					<qCase>
						<instruction text="&#34;OUTPUT &#34;&#34;Programm wird beendet.&#34;&#34;&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
					</qCase>
					<qCase>
						<instruction text="&#34;OUTPUT &#34;&#34;Ungültige Anwort&#34;&#34;&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
					</qCase>
				</case>
			</qWhile>
		</while>
	</children>
</root>