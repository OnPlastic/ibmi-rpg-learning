<?xml version="1.0" encoding="UTF-8"?>
<root xmlns:nsd="https://structorizer.fisch.lu" version="3.32-35" preRepeat="until " postFor="to" preReturn="return" postForIn="in" preWhile="while " output="OUTPUT" input="INPUT" preFor="for" preExit="exit" preLeave="leave" ignoreCase="true" preThrow="throw" preForIn="foreach" stepFor="by" author="Admin" created="2026-10-21" changedby="Admin" changed="2026-10-23" origin="Structorizer 3.32-35" text="&#34;CUSTCRUD_MAIN&#34;" comment="" color="ffffff" type="program" style="nice">
	<children>
		<repeat text="&#34;UNTIL choice = 5&#34;" comment="&#34;&#34;" color="ffffff" disabled="0">
			<qRepeat>
				<instruction text="&#34;choice &#60;- 0&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
				<instruction text="&#34;INPUT &#34;&#34;KUNDENVERWALTUNG\n\n1 - Kunden anzeigen\n2 - Kunde anlegen\n3 - Kunde aendern\n4 - Kunde loeschen\n5 - Programm beenden\n\nAuswahl:&#34;&#34;, choice&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
				<case text="&#34;(choice)&#34;,&#34;1&#34;,&#34;2&#34;,&#34;3&#34;,&#34;4&#34;,&#34;5&#34;,&#34;default&#34;" comment="&#34;&#34;" color="ffffff" branch_colors=",,,,," disabled="0">
					<qCase>
						<call text="&#34;ListCustomers()&#34;" comment="&#34;&#34;" color="ffffff" disabled="0" ismethoddecl="0"></call>
					</qCase>
					<qCase>
						<call text="&#34;AddCustomer()&#34;" comment="&#34;&#34;" color="ffffff" disabled="0" ismethoddecl="0"></call>
					</qCase>
					<qCase>
						<call text="&#34;UpdateCustomer()&#34;" comment="&#34;&#34;" color="ffffff" disabled="0" ismethoddecl="0"></call>
					</qCase>
					<qCase>
						<call text="&#34;DeleteCustomer()&#34;" comment="&#34;&#34;" color="ffffff" disabled="0" ismethoddecl="0"></call>
					</qCase>
					<qCase>
						<instruction text="&#34;OUTPUT &#34;&#34;Programm wird beendet.&#34;&#34;&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
					</qCase>
					<qCase>
						<instruction text="&#34;OUTPUT &#34;&#34;Ungueltige Auswahl.&#34;&#34;&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
					</qCase>
				</case>
			</qRepeat>
		</repeat>
	</children>
</root>